# Server
PORT=3001
NODE_ENV=development

# Database — Azure Database for PostgreSQL (or local Postgres for dev)
# Local:  postgresql://postgres:postgres@localhost:5432/tsa
# Azure:  postgresql://<user>:<pass>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tsa

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Session cookie
COOKIE_SECURE=false

# Email (nodemailer SMTP — works with Azure Communication Services SMTP or any provider)
# Leave SMTP_HOST empty to disable sending (emails logged to console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TSA <no-reply@example.org>"

# Where the app is served (used for links in emails). In dev, the Vite origin.
APP_BASE_URL=http://localhost:5173