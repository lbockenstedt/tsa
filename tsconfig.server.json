{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/server/**/*"],
  "exclude": ["node_modules", "dist", "src/client", "tests", "prisma"]
}